  "fixed_sql": [
    {
      "name": "vehicles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vehicles\" (\"id\" TEXT NOT NULL, \"nickname\" TEXT NOT NULL, \"vin\" TEXT NULL, \"vin_unverified\" INTEGER NOT NULL DEFAULT 0 CHECK (\"vin_unverified\" IN (0, 1)), \"make\" TEXT NOT NULL DEFAULT '', \"model\" TEXT NOT NULL DEFAULT '', \"trim\" TEXT NOT NULL DEFAULT '', \"year\" INTEGER NULL, \"fuel_type\" TEXT NOT NULL, \"odometer_km\" REAL NULL, \"odometer_updated_at\" TEXT NULL, \"plate\" TEXT NULL, \"photo_path\" TEXT NULL, \"cached_protocol\" INTEGER NULL, \"supported_pids_json\" TEXT NULL, \"supports_batching\" INTEGER NOT NULL DEFAULT 0 CHECK (\"supports_batching\" IN (0, 1)), \"is_primary\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_primary\" IN (0, 1)), \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "service_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"service_records\" (\"id\" TEXT NOT NULL, \"vehicle_id\" TEXT NOT NULL REFERENCES vehicles (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL CHECK(LENGTH(\"title\") BETWEEN 1 AND 200), \"date\" TEXT NOT NULL, \"odometer_km\" REAL NULL, \"cost\" REAL NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'USD' CHECK(LENGTH(\"currency_code\") = 3), \"vendor\" TEXT NULL, \"notes\" TEXT NULL CHECK(\"notes\" IS NULL OR LENGTH(\"notes\") <= 5000), \"attachment_paths_json\" TEXT NOT NULL DEFAULT '[]', \"linked_dtcs_json\" TEXT NOT NULL DEFAULT '[]', \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" TEXT NOT NULL, \"vehicle_id\" TEXT NOT NULL REFERENCES vehicles (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL CHECK(LENGTH(\"title\") BETWEEN 1 AND 200), \"detail\" TEXT NULL, \"due_date\" TEXT NULL, \"due_odometer_km\" REAL NULL, \"repeat_every_days\" INTEGER NULL, \"repeat_every_km\" REAL NULL, \"critical\" INTEGER NOT NULL DEFAULT 0 CHECK (\"critical\" IN (0, 1)), \"paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"paused\" IN (0, 1)), \"completed_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "fuel_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fuel_entries\" (\"id\" TEXT NOT NULL, \"vehicle_id\" TEXT NOT NULL REFERENCES vehicles (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"odometer_km\" REAL NOT NULL, \"litres\" REAL NOT NULL, \"cost\" REAL NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'USD' CHECK(LENGTH(\"currency_code\") = 3), \"part_fill\" INTEGER NOT NULL DEFAULT 0 CHECK (\"part_fill\" IN (0, 1)), \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "dtc_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dtc_snapshots\" (\"id\" TEXT NOT NULL, \"vehicle_id\" TEXT NOT NULL REFERENCES vehicles (id) ON DELETE CASCADE, \"taken_at\" TEXT NOT NULL, \"purpose\" TEXT NOT NULL, \"codes_json\" TEXT NOT NULL, \"mil_on\" INTEGER NULL CHECK (\"mil_on\" IN (0, 1)), \"dtc_count\" INTEGER NULL, \"readiness_json\" TEXT NULL, \"protocol\" INTEGER NULL, \"clear_outcome\" TEXT NULL, \"related_snapshot_id\" TEXT NULL, \"freeze_frame_json\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "trip_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_sessions\" (\"id\" TEXT NOT NULL, \"vehicle_id\" TEXT NOT NULL REFERENCES vehicles (id) ON DELETE CASCADE, \"name\" TEXT NULL, \"started_at\" TEXT NOT NULL, \"ended_at\" TEXT NULL, \"last_opened_at\" TEXT NOT NULL, \"distance_km\" REAL NULL, \"avg_speed_kph\" REAL NULL, \"max_speed_kph\" REAL NULL, \"sample_count\" INTEGER NOT NULL DEFAULT 0, \"samples_file_path\" TEXT NOT NULL, \"file_bytes\" INTEGER NOT NULL DEFAULT 0, \"interrupted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"interrupted\" IN (0, 1)), \"fuel_used_l\" REAL NULL, \"recorded_ms\" INTEGER NULL, \"end_reason\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "dashboard_layouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dashboard_layouts\" (\"id\" TEXT NOT NULL, \"vehicle_id\" TEXT NOT NULL REFERENCES vehicles (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 40), \"tiles_json\" TEXT NOT NULL CHECK(CASE WHEN json_valid(tiles_json) THEN json_type(tiles_json) = 'array' AND json_array_length(tiles_json) BETWEEN 1 AND 64 ELSE 0 END), \"created_at\" TEXT NOT NULL, \"selected_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
